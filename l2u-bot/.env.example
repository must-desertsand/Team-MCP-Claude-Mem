# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs to respond in. Empty means every channel.
SLACK_ALLOWED_CHANNELS=

# LiteLLM
LITELLM_BASE_URL=
LITELLM_KEY=
LITELLM_MODEL_CHAIN=
LITELLM_COMPACT_MODEL=

# GitHub / codebase
GITHUB_REPO=
REPO_CLONE_PATH=

# Team-Mem (shared Claude Code memory — optional; tools are omitted when the token is empty)
# NOTE: this is deliberately TEAM_MEM_BOT_TOKEN, not TEAM_MEM_TOKEN — a personal plugin
# token exported in the shell would override the bot's read-only service token otherwise.
TEAM_MEM_URL=http://127.0.0.1:7337
TEAM_MEM_BOT_TOKEN=

# Limits
MAX_TURNS=
TOOL_RESULT_BYTES=
JOB_TIMEOUT_MS=
AUDIT_RETENTION_DAYS=
